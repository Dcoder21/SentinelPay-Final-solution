# Dev environment inputs for infra/environments/dev.
# Filled for the first HTTP-only infrastructure smoke test in eu-west-1.
# Versioned pipeline inputs; do not put AWS credentials or secrets here.

# AWS region where AWS resources will be created. The S3 state-backend region
# is configured separately in backend.tf.
aws_region = "eu-west-1"

# Network values: choose non-overlapping CIDRs that are available in your AWS
# account/network plan. The VPC CIDR must contain every subnet CIDR. Keep the
# public/private subnet lists the same length as availability_zones.
vpc_cidr             = "10.20.0.0/16"
public_subnet_cidrs  = ["10.20.1.0/24", "10.20.2.0/24"]
private_subnet_cidrs = ["10.20.11.0/24", "10.20.12.0/24"]
availability_zones   = ["eu-west-1a", "eu-west-1b"]

# GitHub trust is configured separately in Bootstrap.

# A real ACM certificate ARN in aws_region is needed for the HTTPS listener.
# For this first dev smoke test, enable HTTP explicitly without a certificate.
# Switch this off and supply an issued ACM ARN before deploying real APIs.
acm_certificate_arn    = null
enable_http_smoke_test = true

# Permit HTTPS image pulls from Docker Hub via the existing NAT gateway.
# Disabling this requires private registry/API endpoints and their egress rules.
allow_public_https_egress = true

# Current compute module creates one placeholder container. Replace these with
# settings for the image/service you intend to deploy; this is not yet wired to
# both SentinelPay APIs.
container_image = "nginx:alpine"
container_port  = 80
desired_count   = 1

# Leave null to use the default project-environment prefix.
name_prefix = null

# Optional common resource tags.
tags = {
  Project     = "sentinelpay"
  Environment = "dev"
  ManagedBy   = "Terraform"
}
